---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import TestimonialsCarousel from '../components/TestimonialsCarousel';
---

<Layout title="Quilimbay Turismo - Viajá acompañado">
  <Navbar client:load />

  <!-- Hero Section -->
  <section id="inicio" class="relative min-h-screen flex items-center pt-20">
    <!-- Background Collage -->
    <div class="absolute inset-0 z-0">
      <div class="relative h-full w-full overflow-hidden">
        <!-- Desktop: Collage de imágenes diagonales -->
        <div class="hidden md:grid md:grid-cols-3 h-full">
          <div class="relative overflow-hidden" style="clip-path: polygon(0 0, 100% 0, 85% 100%, 0% 100%);">
            <img 
              src="https://images.unsplash.com/photo-1501594907352-04cda38ebc29?w=800&q=80" 
              alt="Patagonia" 
              class="w-full h-full object-cover"
            />
          </div>
          <div class="relative overflow-hidden" style="clip-path: polygon(15% 0, 100% 0, 85% 100%, 0% 100%);">
            <img 
              src="https://images.unsplash.com/photo-1483729558449-99ef09a8c325?w=800&q=80" 
              alt="Cataratas" 
              class="w-full h-full object-cover"
            />
          </div>
          <div class="relative overflow-hidden" style="clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%);">
            <img 
              src="https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=800&q=80" 
              alt="Playa" 
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Mobile: Una sola imagen -->
        <div class="md:hidden h-full">
          <img 
            src="https://images.unsplash.com/photo-1501594907352-04cda38ebc29?w=800&q=80" 
            alt="Paisaje" 
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Overlay gradient -->
        <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/80 to-transparent"></div>
      </div>
    </div>

    <!-- Content -->
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-gold" fill="currentColor" viewBox="0 0 20 20">
            <path d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" />
          </svg>
          <span class="text-gold text-sm tracking-wider uppercase">Viajes hechos para vos</span>
        </div>

        <h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight">
          <span class="text-white">Viajá acompañado,</span><br />
          <span class="text-gold">no solo transportado</span>
        </h1>

        <p class="text-gray-300 text-lg mb-8 max-w-xl">
          En Quilimbay no vendemos paquetes, construimos experiencias. Te acompañamos antes, durante y después de tu viaje, porque sabemos que viajar bien es mucho más que llegar a un lugar.
        </p>

        <a
          href="https://wa.me/5492804581234"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-gold text-navy px-8 py-4 rounded-lg font-bold text-lg hover:bg-gold-dark transition-all mb-6"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Consultanos tu viaje
        </a>

        <div class="flex items-center gap-3">
          <div class="flex -space-x-2">
            <img src="https://i.pravatar.cc/40?img=10" alt="Viajero" class="w-10 h-10 rounded-full border-2 border-navy" />
            <img src="https://i.pravatar.cc/40?img=11" alt="Viajero" class="w-10 h-10 rounded-full border-2 border-navy" />
            <img src="https://i.pravatar.cc/40?img=12" alt="Viajero" class="w-10 h-10 rounded-full border-2 border-navy" />
            <img src="https://i.pravatar.cc/40?img=13" alt="Viajero" class="w-10 h-10 rounded-full border-2 border-navy" />
          </div>
          <div class="flex items-center gap-2">
            <span class="text-gray-300 text-sm">Más de 1.000 viajeros ya viajaron con nosotros</span>
            <svg class="w-5 h-5 text-gold" fill="currentColor" viewBox="0 0 20 20">
              <path d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Por qué Quilimbay Section -->
  <section id="experiencias" class="py-20 bg-navy">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <div class="flex items-center justify-center gap-4 mb-4">
          <div class="h-px w-16 bg-gold"></div>
          <h2 class="text-4xl md:text-5xl font-bold text-white">¿Por qué Quilimbay?</h2>
          <div class="h-px w-16 bg-gold"></div>
        </div>
      </div>

      <!-- Desktop: 3 columnas -->
      <div class="hidden md:grid md:grid-cols-3 gap-8">
        <div class="bg-navy-lighter border border-gold/20 rounded-lg p-8 text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full border-2 border-gold flex items-center justify-center">
            <svg class="w-8 h-8 text-gold" fill="currentColor" viewBox="0 0 20 20">
              <path d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Acompañamiento personalizado</h3>
          <p class="text-gray-300">
            No vendemos paquetes estándar. Cada viaje se diseña escuchando lo que realmente querés vivir, con atención antes, durante y después.
          </p>
        </div>

        <div class="bg-navy-lighter border border-gold/20 rounded-lg p-8 text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full border-2 border-gold flex items-center justify-center">
            <svg class="w-8 h-8 text-gold" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Atención humana real</h3>
          <p class="text-gray-300">
            Sin chatbots ni respuestas automáticas. Personas reales que responden rápido, entienden tus dudas y están cuando las necesitás.
          </p>
        </div>

        <div class="bg-navy-lighter border border-gold/20 rounded-lg p-8 text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full border-2 border-gold flex items-center justify-center">
            <svg class="w-8 h-8 text-gold" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Experiencia por sobre precio</h3>
          <p class="text-gray-300">
            Priorizamos que vivas el destino de verdad. Calidad, cercanía y momentos que importan, no la opción más barata ni la más cara.
          </p>
        </div>
      </div>

      <!-- Mobile: cards horizontales -->
      <div class="md:hidden space-y-4">
        <div class="bg-navy-lighter border border-gold/20 rounded-lg p-6 flex items-start gap-4">
          <div class="w-12 h-12 flex-shrink-0 rounded-full border-2 border-gold flex items-center justify-center">
            <svg class="w-6 h-6 text-gold" fill="currentColor" viewBox="0 0 20 20">
              <path d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" />
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-bold text-white mb-2">Acompañamiento personalizado</h3>
            <p class="text-gray-300 text-sm">
              No vendemos paquetes estándar. Cada viaje se diseña escuchando lo que realmente querés vivir.
            </p>
          </div>
          <svg class="w-5 h-5 text-gold flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>

        <div class="bg-navy-lighter border border-gold/20 rounded-lg p-6 flex items-start gap-4">
          <div class="w-12 h-12 flex-shrink-0 rounded-full border-2 border-gold flex items-center justify-center">
            <svg class="w-6 h-6 text-gold" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-bold text-white mb-2">Atención humana real</h3>
            <p class="text-gray-300 text-sm">
              Sin chatbots. Personas reales que responden rápido y están cuando las necesitás.
            </p>
          </div>
          <svg class="w-5 h-5 text-gold flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>

        <div class="bg-navy-lighter border border-gold/20 rounded-lg p-6 flex items-start gap-4">
          <div class="w-12 h-12 flex-shrink-0 rounded-full border-2 border-gold flex items-center justify-center">
            <svg class="w-6 h-6 text-gold" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-bold text-white mb-2">Experiencia por sobre precio</h3>
            <p class="text-gray-300 text-sm">
              Priorizamos que vivas el destino de verdad. Calidad y momentos que importan.
            </p>
          </div>
          <svg class="w-5 h-5 text-gold flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Destinos Section -->
  <section id="destinos" class="py-20 bg-navy-light">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">Destinos destacados</h2>
        <p class="text-gray-300 max-w-2xl mx-auto">
          Desde la Patagonia hasta el Caribe, experiencias únicas en cada rincón
        </p>
      </div>

      <!-- Nacionales -->
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <svg class="w-6 h-6 text-gold" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
          </svg>
          <h3 class="text-2xl font-bold text-gold">Destinos Nacionales</h3>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          {[
            { name: 'Salta', image: 'https://images.unsplash.com/photo-1590873461702-df0fd46bd20a?w=400&q=80' },
            { name: 'Cataratas del Iguazú', image: 'https://images.unsplash.com/photo-1483729558449-99ef09a8c325?w=400&q=80' },
            { name: 'Ushuaia', image: 'https://images.unsplash.com/photo-1530841377377-3ff06c0ca713?w=400&q=80' },
            { name: 'El Calafate', image: 'https://images.unsplash.com/photo-1501594907352-04cda38ebc29?w=400&q=80' },
            { name: 'Mendoza', image: 'https://images.unsplash.com/photo-1506377247377-2a5b3b417ebb?w=400&q=80' },
            { name: 'Buenos Aires', image: 'https://images.unsplash.com/photo-1589909202802-8f4aadce1849?w=400&q=80' },
          ].map((destino) => (
            <div class="group relative h-64 rounded-lg overflow-hidden cursor-pointer">
              <img src={destino.image} alt={destino.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/50 to-transparent"></div>
              <div class="absolute inset-0 flex flex-col justify-end p-4">
                <h4 class="text-white font-bold text-lg mb-2">{destino.name}</h4>
                <a
                  href="https://wa.me/5492804581234"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-gold text-sm hover:text-gold-dark transition-colors"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                  </svg>
                  Consultar
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Internacionales -->
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <svg class="w-6 h-6 text-gold" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
          </svg>
          <h3 class="text-2xl font-bold text-gold">Destinos Internacionales</h3>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-3xl">
          {[
            { name: 'Caribe', image: 'https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=400&q=80' },
            { name: 'Europa', image: 'https://images.unsplash.com/photo-1467269204594-9661b134dd2b?w=400&q=80' },
            { name: 'Brasil', image: 'https://images.unsplash.com/photo-1483729558449-99ef09a8c325?w=400&q=80' },
          ].map((destino) => (
            <div class="group relative h-64 rounded-lg overflow-hidden cursor-pointer">
              <img src={destino.image} alt={destino.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/50 to-transparent"></div>
              <div class="absolute inset-0 flex flex-col justify-end p-4">
                <h4 class="text-white font-bold text-lg mb-2">{destino.name}</h4>
                <a
                  href="https://wa.me/5492804581234"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-gold text-sm hover:text-gold-dark transition-colors"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                  </svg>
                  Consultar
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Receptivo Patagonia -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <svg class="w-6 h-6 text-gold" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
          </svg>
          <h3 class="text-2xl font-bold text-gold">Turismo Receptivo Patagonia</h3>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-3xl">
          {[
